# Copy to .env and fill in when connecting real services. Nothing here is needed for the demo.
# Keys starting with VITE_ are visible in the browser — only put PUBLIC keys there.
# Secret keys belong in Supabase Edge Function secrets (supabase secrets set ...), never in the website.

# --- Supabase (database, auth, storage) ---
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # server only

# --- Payments: Paystack (or Flutterwave) ---
VITE_PAYSTACK_PUBLIC_KEY=pk_test_xxx
PAYSTACK_SECRET_KEY=sk_test_xxx        # server only
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=                # server only

# --- Identity verification: Dojah (NIN, licence, selfie) ---
DOJAH_APP_ID=
DOJAH_SECRET_KEY=                      # server only
DOJAH_BASE_URL=https://api.dojah.io

# --- WhatsApp Business Cloud API ---
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=                 # server only
WHATSAPP_VERIFY_TOKEN=                 # webhook verification string you choose

# --- GPS tracking: Traccar server ---
TRACCAR_URL=https://track.yourdomain.com
TRACCAR_USER=
TRACCAR_PASSWORD=                      # server only

# --- AI (concierge, damage detection, business analyst) ---
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=                     # server only
AI_MODEL=claude-sonnet-5-5

# --- Email / notifications ---
RESEND_API_KEY=                        # server only
NOTIFY_FROM_EMAIL=bookings@yourdomain.com

# --- Maps (optional; default Esri tiles need no key) ---
VITE_CARTO_API_KEY=
